{
	"name": "obsidian-timeflow",
	"version": "1.1.0",
	"description": "Infinite vertical temporal feed for Periodic Notes",
	"author": "smirnoffmg",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"bundle": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build": "npm test && npm run bundle",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "2.1.9",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"husky": "^9.1.7",
		"jiti": "2.6.1",
		"prettier": "^3.8.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "2.1.9"
	},
	"dependencies": {
		"obsidian": "1.8.7",
		"obsidian-daily-notes-interface": "^0.9.4"
	}
}
